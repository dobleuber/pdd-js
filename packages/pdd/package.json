  },
  "peerDependenciesMeta": {
    "@stryker-mutator/api": {
      "optional": true
    },
    "@stryker-mutator/core": {
      "optional": true
    },
    "@stryker-mutator/typescript-checker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
